   "encode": {
    "description": "raw UTF-8 text -> ids",
    "adapters": {
     "tokie": "Tokenizer.encode(text) -> np.uint32 ids",
     "giga": "Tokenizer.encode(text) -> np.uint32 ids",
     "hf": "Tokenizer.encode(text, add_special_tokens=False).ids -> list"
