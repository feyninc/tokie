    "adapters": {
     "tokie": "Tokenizer.decode(ids) -> str",
     "giga": "Tokenizer.decode(ids) -> bytes; .decode('utf-8','replace') inside clock",
     "hf": "Tokenizer.decode(ids.tolist(), skip_special_tokens=False); array-to-list inside clock"
